# Local Vite dev server (build-time). Docker runtime uses API_BASE_URL / BLOB_* instead.
VITE_API_BASE_URL=http://localhost:8080
VITE_BLOB_BASE_URL=https://<youraccount>.blob.core.windows.net
VITE_BLOB_CONTAINER_NAME=agentdata

# Docker/runtime equivalents (written into /app-config.js by the entrypoint):
# API_BASE_URL=http://192.168.40.159:8082
# BLOB_BASE_URL=https://<youraccount>.blob.core.windows.net
# BLOB_CONTAINER_NAME=agentdata
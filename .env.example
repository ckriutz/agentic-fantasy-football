# LeagueAPI Docker Compose Configuration
# Copy this file to .env and fill in the required values

# --- Container Ports ---
LEAGUEAPI_PORT=8082
LEAGUEFRONTEND_PORT=3000
YAHOODATASYNC_PORT=8003
POSTGRES_PORT=5432

# --- PostgreSQL Configuration (Required for the postgres container) ---
POSTGRES_DB=leagueapi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# --- SportsData.io Configuration (Required if enabled) ---
SPORTSDATA_ENABLED=true
SPORTSDATA_API_KEY=your_sportsdata_api_key_here

# --- Yahoo Fantasy Configuration (Required if enabled) ---
# Get these from Yahoo Developer Console: https://developer.yahoo.com/apps/
YAHOO_CLIENT_ID=your_yahoo_client_id_here
YAHOO_CLIENT_SECRET=your_yahoo_client_secret_here
# Legacy aliases remain supported during migration:
YahooClientId=
YahooClientSecret=
YAHOO_REDIRECT_URI=http://localhost:8003/api/yahoo/auth/callback
YAHOO_SYNC_ENABLED=true
YAHOO_SYNC_RUN_ON_STARTUP=false
YAHOO_SYNC_PAGE_SIZE=25
YAHOO_SYNC_HOUR_UTC=6
YAHOO_SYNC_MINUTE_UTC=45
YAHOO_STORAGE_CONTAINER_NAME=yahoodata
YAHOO_OAUTH_STATE_BLOB_NAME=yahoo/private/oauth-state.json
# Optional. Leave blank to resolve the game key from Yahoo using LeagueAPI's season.
YAHOO_GAME_KEY=
# Browser origins permitted to call LeagueAPI and YahooDataSync.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://192.168.40.159:3000

# --- AgenticLeague LLM/Image Providers (Required for AgenticLeague) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
XAI_API_KEY=your_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1/
FoundryKey=your_foundry_key_here
FoundryEndpoint=https://api.foundry.ai/v1/
AZURE_STORAGE_CONNECTION_STRING="..."
AZURE_STORAGE_CONTAINER_NAME="..."
META_API_KEY=your_meta_api_key_here
FANTASY_PROS_API_KEY=your_fantasy_pros_api_key_here
SLEEPER_STORAGE_CONTAINER_NAME=playerdata
SPORTSDATA_STORAGE_CONTAINER_NAME=playerdata
FANTASYPROS_STORAGE_CONTAINER_NAME=fantasyprosdata

# --- Database connection used by LeagueAPI (Required) ---
DBConnectionString=Host=postgres;Port=5432;Database=leagueapi;Username=postgres;Password=your_postgres_password_here
FRONTEND_API_BASE_URL=http://localhost:8080
FRONTEND_YAHOO_API_BASE_URL=http://192.168.40.159:8003
# Pi deployment: set FRONTEND_API_BASE_URL=http://192.168.40.159:8082

# ASP.NET Core runtime
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:8080

Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

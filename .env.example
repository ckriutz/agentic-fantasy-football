# LeagueAPI Docker Compose Configuration
# Copy this file to .env and fill in the required values

# --- Container Ports ---
LEAGUEAPI_PORT=8080
LEAGUEFRONTEND_PORT=3000
POSTGRES_PORT=5432

# --- PostgreSQL Configuration (Required for the postgres container) ---
POSTGRES_DB=leagueapi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# --- SportsData.io Configuration (Required if enabled) ---
SPORTSDATA_ENABLED=true
SPORTSDATA_API_KEY=your_sportsdata_api_key_here

# --- Yahoo Fantasy Configuration (Required if enabled) ---
# Get these from Yahoo Developer Console: https://developer.yahoo.com/apps/
YahooClientId=your_yahoo_client_id_here
YahooClientSecret=your_yahoo_client_secret_here
YAHOO_REDIRECT_URI=https://localhost:5001/api/yahoo/auth/callback
YAHOO_SYNC_ENABLED=true

# --- AgenticLeague LLM/Image Providers (Required for AgenticLeague) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
XAI_API_KEY=your_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1/
FoundryKey=your_foundry_key_here
FoundryEndpoint=https://api.foundry.ai/v1/
AZURE_STORAGE_CONNECTION_STRING="..."
AZURE_STORAGE_CONTAINER_NAME="..."
META_API_KEY=your_meta_api_key_here
FANTASY_PROS_API_KEY=your_fantasy_pros_api_key_here
SLEEPER_STORAGE_CONTAINER_NAME=playerdata
SPORTSDATA_STORAGE_CONTAINER_NAME=playerdata
FANTASYPROS_STORAGE_CONTAINER_NAME=fantasyprosdata

# --- Database connection used by LeagueAPI (Required) ---
DBConnectionString=Host=postgres;Port=5432;Database=leagueapi;Username=postgres;Password=your_postgres_password_here
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_API_BASE_URL=http://localhost:8080

# ASP.NET Core runtime
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:8080

# LeagueAPI sync/settings overrides


YahooOAuth__AuthorizationUrl=https://api.login.yahoo.com/oauth2/request_auth
YahooOAuth__TokenUrl=https://api.login.yahoo.com/oauth2/get_token
YahooOAuth__FantasyApiBaseUrl=https://fantasysports.yahooapis.com/fantasy/v2
YahooOAuth__Scope=fspt-r

YahooSync__DefaultGameKey=461
YahooSync__DefaultSeason=2025
YahooSync__DefaultWeek=1
YahooSync__PageSize=25
YahooSync__DailySyncHourUtc=6
YahooSync__RunOnStartup=false

Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
